<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{% block page_title %}{{ page_title }}{% endblock %}</title>
<script src="https://cdn.tailwindcss.com"></script>
<script>tailwind.config = { darkMode: 'media' };</script>
<script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
<style type="text/tailwindcss">
  .card { @apply rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900; }
  .lbl  { @apply flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-2; }
  .inp  { @apply w-full rounded-lg border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-950 px-3 py-2 text-sm text-zinc-900 dark:text-zinc-100 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/25; }
  .btnp { @apply w-full inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500 disabled:opacity-50 disabled:cursor-progress; }
  .btng { @apply inline-flex items-center gap-1.5 rounded-lg border border-zinc-300 dark:border-zinc-700 px-3 py-1.5 text-sm font-medium text-zinc-700 dark:text-zinc-300 transition hover:border-indigo-500 hover:text-indigo-600 dark:hover:text-indigo-400 disabled:opacity-40 disabled:pointer-events-none; }
  .chip { @apply text-xs font-medium px-2.5 py-1.5 rounded-lg border border-zinc-300 dark:border-zinc-700 text-zinc-600 dark:text-zinc-300 transition hover:border-indigo-400 cursor-pointer select-none; }
  .chip-on { @apply bg-indigo-600 border-indigo-600 text-white hover:border-indigo-600; }
  .badge { @apply inline-block text-[10px] font-bold uppercase tracking-wide px-2 py-1 rounded; }
  .b-deal { @apply bg-emerald-100 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-400; }
  .b-match { @apply bg-emerald-100 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-400; }
  .b-review { @apply bg-amber-100 text-amber-700 dark:bg-amber-500/15 dark:text-amber-400; }
  .b-filtered { @apply bg-rose-100 text-rose-700 dark:bg-rose-500/15 dark:text-rose-400; }
  .b-ok { @apply bg-zinc-100 text-zinc-600 dark:bg-zinc-500/15 dark:text-zinc-300; }
  .th { @apply px-4 py-2.5 text-left text-[11px] font-bold uppercase tracking-wide text-zinc-500 dark:text-zinc-400 whitespace-nowrap; }
  .td { @apply px-4 py-3 border-t border-zinc-100 dark:border-zinc-800 align-top; }
</style>
<style>
  .tabnum{font-variant-numeric:tabular-nums}
  .prog{height:2px;overflow:hidden}
  .prog.on{background:rgba(99,102,241,.18)}
  .prog.on i{display:block;height:100%;width:32%;background:#6366f1;animation:sl 1.1s ease-in-out infinite}
  @keyframes sl{0%{margin-left:-32%}100%{margin-left:100%}}
  .pulse{animation:pl 1s ease-in-out infinite}@keyframes pl{50%{opacity:.35}}
  @media (prefers-reduced-motion:reduce){.prog.on i,.pulse{animation:none}}
  .term{background:#0a0a0b;color:#d4d4d8}
  .term-body{max-height:230px;overflow:auto;scrollbar-width:thin}
  .term-body::-webkit-scrollbar{width:8px}.term-body::-webkit-scrollbar-thumb{background:#27272a;border-radius:8px}
  .acwrap{position:relative}
  .ac{position:absolute;z-index:40;left:0;right:0;top:calc(100% + 4px);background:#fff;border:1px solid #e4e4e7;border-radius:10px;overflow:hidden;box-shadow:0 10px 30px -12px rgba(0,0,0,.25)}
  .ac-item{display:flex;justify-content:space-between;gap:8px;align-items:center;padding:8px 11px;font-size:.82rem;cursor:pointer;color:#18181b}
  .ac-item:hover{background:#eef2ff;color:#3730a3}
  .ac-type{font-size:.62rem;text-transform:uppercase;letter-spacing:.04em;color:#a1a1aa}
  @media (prefers-color-scheme:dark){.ac{background:#18181b;border-color:#27272a}.ac-item{color:#e4e4e7}.ac-item:hover{background:#312e81;color:#e0e7ff}.ac-type{color:#71717a}}
  .tr-deal td:first-child{box-shadow:inset 3px 0 0 #10b981}
  .tr-match td:first-child{box-shadow:inset 3px 0 0 #10b981}
  .fitbar{height:6px;border-radius:4px;background:#e4e4e7;overflow:hidden;width:44px}
  @media (prefers-color-scheme:dark){.fitbar{background:#3f3f46}}
</style>
</head>
<body class="bg-zinc-50 dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100 antialiased">

<nav class="sticky top-0 z-30 bg-white/90 dark:bg-zinc-950/90 backdrop-blur border-b border-zinc-200 dark:border-zinc-800">
  <div class="max-w-7xl mx-auto px-6 h-14 flex items-center gap-4">
    <a href="/" class="inline-flex items-center gap-1.5 text-sm text-zinc-500 dark:text-zinc-400 hover:text-indigo-600 dark:hover:text-indigo-400 shrink-0" title="All tools"><i data-lucide="arrow-left" class="w-4 h-4"></i><span class="hidden sm:inline">Tools</span></a>
    <span class="w-px h-5 bg-zinc-200 dark:bg-zinc-800"></span>
    <div class="flex items-center gap-2">
      <span class="w-7 h-7 rounded-md bg-indigo-600 flex items-center justify-center text-white"><i data-lucide="{{ icon }}" class="w-4 h-4"></i></span>
      <span class="font-semibold tracking-tight">{{ brand_title }}</span>
    </div>
    <span class="hidden md:flex items-center gap-1.5 text-sm text-zinc-500 dark:text-zinc-400 border-l border-zinc-200 dark:border-zinc-800 pl-4">{{ tagline }}</span>
    <div class="ml-auto flex items-center gap-3 text-sm text-zinc-500 dark:text-zinc-400">
      <span class="flex items-center gap-2"><span id="led" class="w-2 h-2 rounded-full bg-zinc-400"></span><span id="statusTxt">Ready</span></span>
      <button id="openSettings" type="button" class="inline-flex items-center gap-1.5 rounded-lg border border-zinc-300 dark:border-zinc-700 px-2.5 py-1 hover:border-indigo-500 hover:text-indigo-600 dark:hover:text-indigo-400"><i data-lucide="settings" class="w-4 h-4"></i><span class="hidden sm:inline">Settings</span></button>
    </div>
  </div>
  <div id="prog" class="prog"><i></i></div>
</nav>

<main class="max-w-7xl mx-auto px-6 py-6 grid grid-cols-1 lg:grid-cols-[340px_1fr] gap-6 items-start">

  <!-- QUERY -->
  <aside class="card lg:sticky lg:top-20">
    <div class="px-5 py-3.5 border-b border-zinc-200 dark:border-zinc-800 flex items-center gap-2">
      <i data-lucide="sliders-horizontal" class="w-4 h-4 text-indigo-500"></i>
      <h2 class="text-xs font-bold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">{{ form_title }}</h2>
    </div>
    <form id="form" class="p-5 space-y-5">
{% block form %}{% endblock %}
    </form>
  </aside>

  <!-- MAIN -->
  <section class="space-y-6 min-w-0">
    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
      <div class="term rounded-xl border border-zinc-800 xl:col-span-2 overflow-hidden">
        <div class="flex items-center gap-2 px-4 py-2.5 border-b border-zinc-800">
          <span class="w-3 h-3 rounded-full bg-red-500/80"></span><span class="w-3 h-3 rounded-full bg-amber-500/80"></span><span class="w-3 h-3 rounded-full bg-emerald-500/80"></span>
          <span class="ml-2 text-xs font-mono text-zinc-400 flex items-center gap-1.5"><i data-lucide="terminal" class="w-3.5 h-3.5"></i>process</span>
          <span id="termState" class="ml-auto text-[11px] font-mono text-zinc-500">idle</span>
        </div>
        <div id="term" class="term-body px-4 py-3 font-mono text-[12.5px] leading-relaxed"><div class="text-zinc-500">Waiting for a search…</div></div>
      </div>
      <div class="card overflow-hidden">
        <div class="px-4 py-2.5 border-b border-zinc-200 dark:border-zinc-800 flex items-center gap-2">
          <i data-lucide="{{ platforms_icon }}" class="w-4 h-4 text-indigo-500"></i>
          <h3 class="text-xs font-bold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">{{ platforms_label }}</h3>
        </div>
        <div id="platforms" class="p-4 flex flex-wrap gap-2"><span class="text-sm text-zinc-400">None yet.</span></div>
      </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
      {% for lbl in stat_labels %}
      <div class="card px-4 py-3.5"><div id="s{{ loop.index0 }}" class="text-2xl font-semibold tabnum{% if loop.index0 == 1 %} text-emerald-600 dark:text-emerald-400{% endif %}">—</div><div class="text-[11px] uppercase tracking-wide text-zinc-500 dark:text-zinc-400 mt-0.5">{{ lbl }}</div></div>
      {% endfor %}
    </div>

    <div class="flex items-center gap-3 flex-wrap">
      <div id="filter" class="inline-flex rounded-lg border border-zinc-300 dark:border-zinc-700 overflow-hidden text-sm">
        <button data-f="all" class="px-3.5 py-1.5 font-medium bg-indigo-50 dark:bg-indigo-500/15 text-indigo-700 dark:text-indigo-300">All</button>
        <button data-f="{{ positive_status }}" class="px-3.5 py-1.5 font-medium border-l border-zinc-300 dark:border-zinc-700 text-zinc-500 dark:text-zinc-400">{{ positive_label }}</button>
      </div>
      <span id="count" class="text-sm text-zinc-500 dark:text-zinc-400"></span>
      <div class="ml-auto flex gap-2">
        <button id="expCsv" class="btng" disabled><i data-lucide="download" class="w-4 h-4"></i>CSV</button>
        <button id="expJson" class="btng" disabled><i data-lucide="download" class="w-4 h-4"></i>JSON</button>
      </div>
    </div>

    <div class="card overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm min-w-[{{ table_minw | default('880px') }}]">
          <thead class="bg-zinc-50 dark:bg-zinc-900/60">
            <tr class="border-b border-zinc-200 dark:border-zinc-800">
{% block table_head %}{% endblock %}
            </tr>
          </thead>
          <tbody id="rows"><tr><td colspan="{{ ncols }}" class="td text-center text-zinc-400 py-12">{% block table_empty %}{% endblock %}</td></tr></tbody>
        </table>
      </div>
    </div>
  </section>
</main>

{% block page_scripts %}
<script>
{% block tool_config %}{% endblock %}
</script>
<script src="/static/engine.js"></script>
{% endblock %}

<!-- SETTINGS MODAL -->
<div id="settingsOverlay" class="hidden fixed inset-0 z-50 bg-zinc-950/50 backdrop-blur-sm flex items-center justify-center p-4">
  <div class="card w-full max-w-md shadow-2xl">
    <div class="flex items-center justify-between px-5 py-3.5 border-b border-zinc-200 dark:border-zinc-800">
      <div class="flex items-center gap-2">
        <i data-lucide="key-round" class="w-4 h-4 text-indigo-500"></i>
        <h2 class="text-sm font-bold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">AI provider &amp; key</h2>
      </div>
      <button id="closeSettings" type="button" class="text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200"><i data-lucide="x" class="w-5 h-5"></i></button>
    </div>
    <div class="p-5 space-y-4">
      <div>
        <label class="lbl" for="setProvider"><i data-lucide="cpu" class="w-3.5 h-3.5"></i>Provider</label>
        <select id="setProvider" class="inp">
          <option value="openai">OpenAI</option>
          <option value="anthropic">Anthropic (Claude)</option>
          <option value="xai">xAI (Grok)</option>
        </select>
      </div>
      <div>
        <label class="lbl" for="setKey"><i data-lucide="lock" class="w-3.5 h-3.5"></i>API key</label>
        <div class="flex gap-2">
          <input id="setKey" type="password" class="inp" placeholder="Paste key, then Load models" autocomplete="off" />
          <button id="loadModels" type="button" class="btng shrink-0"><i data-lucide="refresh-cw" class="w-4 h-4"></i>Load</button>
        </div>
        <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-1.5">Stored on the server (this machine), never kept in the browser.</p>
      </div>
      <div>
        <label class="lbl" for="setModel"><i data-lucide="box" class="w-3.5 h-3.5"></i>Model</label>
        <select id="setModel" class="inp"><option value="">Load models to choose…</option></select>
      </div>
      <div id="setStatus" class="text-xs"></div>
      <button id="saveSettings" type="button" class="btnp"><i data-lucide="check" class="w-4 h-4"></i>Save</button>
    </div>
  </div>
</div>

<script src="/static/settings.js"></script>
</body>
</html>
