{% extends "base.html.j2" %}
{% set page_title = "Used Car Finder" %}
{% set icon = "car" %}
{% set brand_title = "Used Car Finder" %}
{% set tagline = "Real listings, priced against the market" %}
{% set form_title = "What are you looking for?" %}
{% set platforms_icon = "store" %}
{% set platforms_label = "Sites" %}
{% set stat_labels = ["Listings", "Deals", "Best price", "Sites"] %}
{% set positive_status = "deal" %}
{% set positive_label = "Deals" %}
{% set ncols = 8 %}

{% block table_empty %}Name a make/model and run a search.{% endblock %}

{% block form %}
      <div>
        <label class="lbl" for="country"><i data-lucide="globe" class="w-3.5 h-3.5"></i>Country</label>
        <select id="country" class="inp">
          <option data-cur="₹" value="India" selected>India</option>
          <option data-cur="$" value="United States">United States</option>
          <option data-cur="£" value="United Kingdom">United Kingdom</option>
          <option data-cur="AED " value="United Arab Emirates">United Arab Emirates</option>
          <option data-cur="C$" value="Canada">Canada</option>
          <option data-cur="A$" value="Australia">Australia</option>
          <option data-cur="S$" value="Singapore">Singapore</option>
        </select>
      </div>
      <div>
        <label class="lbl" for="location"><i data-lucide="map-pin" class="w-3.5 h-3.5"></i>Location</label>
        <input id="location" class="inp" value="Bengaluru" placeholder="e.g. Bengaluru" />
      </div>
      <div>
        <label class="lbl" for="query"><i data-lucide="car-front" class="w-3.5 h-3.5"></i>Model</label>
        <input id="query" class="inp" value="Honda City" placeholder="e.g. Honda City" />
      </div>
      <div>
        <label class="lbl" for="max_price"><i data-lucide="wallet" class="w-3.5 h-3.5"></i>Max price</label>
        <div class="relative">
          <span id="curPrefix" class="absolute left-3 top-1/2 -translate-y-1/2 text-sm text-zinc-500 pointer-events-none">₹</span>
          <input id="max_price" type="number" class="inp pl-8" value="1000000" />
        </div>
      </div>
      <div>
        <label class="lbl" for="min_year"><i data-lucide="calendar" class="w-3.5 h-3.5"></i>Min year</label>
        <input id="min_year" type="number" class="inp" value="2018" />
      </div>
      <div>
        <label class="lbl"><i data-lucide="fuel" class="w-3.5 h-3.5"></i>Fuel</label>
        <div id="fuel" class="flex flex-wrap gap-2"></div>
      </div>
      <div>
        <label class="lbl" for="threshold"><i data-lucide="percent" class="w-3.5 h-3.5"></i>Deal score ≥</label>
        <input id="threshold" type="number" min="0" max="100" class="inp" value="60" />
      </div>
      <button id="go" type="submit" class="btnp"><i data-lucide="search" class="w-4 h-4"></i>Find deals</button>
      <p class="text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed">Searches car marketplaces for live listings, then rates each one against typical market value — so you see genuine good buys, not just cheap prices.</p>
{% endblock %}

{% block table_head %}
              <th class="th w-14"></th>
              <th class="th">Car</th>
              <th class="th text-right cursor-pointer select-none" data-sort="price">Price <span class="ar text-indigo-500" data-for="price"></span></th>
              <th class="th text-right">Typical</th>
              <th class="th cursor-pointer select-none" data-sort="score">Deal <span class="ar text-indigo-500" data-for="score"></span></th>
              <th class="th">Verdict</th>
              <th class="th">Site</th>
              <th class="th"></th>
{% endblock %}

{% block tool_config %}
window.TOOL = {
  endpoint: "/api/cars",
  event: "car",
  itemKey: "car",
  positiveStatus: "deal",
  emptyMsg: "No listings found",
  filename: "cars",
  jsonMode: "spread",
  chips: [{ el:"fuel", options:["Any","Petrol","Diesel","EV","Hybrid"], multi:false, selected:["Any"] }],
  params: () => ({
    country: $("country").value, location: $("location").value, query: $("query").value, currency,
    max_price: $("max_price").value, min_year: $("min_year").value, fuel: chip("fuel")[0]||"Any", threshold: $("threshold").value,
  }),
  columns: [
    { cell:(o)=>tdThumb(o) },
    { cell:(o)=>tdTitle(o, o.title||"Untitled", [o.year, o.mileage, o.fuel, o.transmission, o.location].filter(Boolean).join(" · ")) },
    { cell:(o)=>`<td class="td text-right tabnum font-medium whitespace-nowrap">${money(o.price)}</td>` },
    { cell:(o)=>`<td class="td text-right tabnum text-zinc-500 dark:text-zinc-400 whitespace-nowrap">${money(o.typical_price)}</td>` },
    { cell:(o,r)=>tdScore(r) },
    { cell:(o,r)=>tdBadge(r) },
    { cell:(o)=>tdMuted(o.source) },
    { cell:(o)=>tdLink(o,"View") },
  ],
  summary: [
    { value:(rs)=>rs.length||"—" },
    { value:(rs)=>rs.filter(r=>r.deal).length },
    { value:(rs)=>{ const p=rs.map(r=>r.car.price).filter(x=>typeof x==="number"); return p.length?money(Math.min(...p)):"—"; } },
    { value:(rs)=>new Set(rs.map(r=>r.car.source).filter(Boolean)).size||"—" },
  ],
  exportCols: [
    { name:"title", get:r=>r.car.title },
    { name:"price", get:r=>r.car.price },
    { name:"typical_price", get:r=>r.car.typical_price },
    { name:"year", get:r=>r.car.year },
    { name:"mileage", get:r=>r.car.mileage },
    { name:"fuel", get:r=>r.car.fuel },
    { name:"transmission", get:r=>r.car.transmission },
    { name:"location", get:r=>r.car.location },
    { name:"deal_score", get:r=>r.score },
    { name:"deal", get:r=>r.deal },
    { name:"verdict", get:r=>r.verdict },
    { name:"source", get:r=>r.car.source },
    { name:"url", get:r=>r.car.url },
  ],
};
{% endblock %}
