{% extends "base.html.j2" %}
{% set page_title = "Apartment Hunter" %}
{% set icon = "building-2" %}
{% set brand_title = "Apartment Hunter" %}
{% set tagline = "Live rental intelligence, scored to your brief" %}
{% set form_title = "Search brief" %}
{% set platforms_icon = "layers" %}
{% set platforms_label = "Platforms scraped" %}
{% set stat_labels = ["Listings", "Matches", "Median rent", "Platforms"] %}
{% set positive_status = "match" %}
{% set positive_label = "Matches" %}
{% set ncols = 9 %}
{% set table_minw = "900px" %}

{% block table_empty %}Set your brief and run a search.{% endblock %}

{% block form %}
      <div>
        <label class="lbl" for="country"><i data-lucide="globe" class="w-3.5 h-3.5"></i>Country</label>
        <select id="country" class="inp">
          <option data-cur="₹" value="India" selected>India</option>
          <option data-cur="$" value="United States">United States</option>
          <option data-cur="£" value="United Kingdom">United Kingdom</option>
          <option data-cur="AED " value="United Arab Emirates">United Arab Emirates</option>
          <option data-cur="C$" value="Canada">Canada</option>
          <option data-cur="A$" value="Australia">Australia</option>
          <option data-cur="S$" value="Singapore">Singapore</option>
        </select>
      </div>
      <div class="acwrap">
        <label class="lbl" for="city"><i data-lucide="map-pin" class="w-3.5 h-3.5"></i>City</label>
        <input id="city" class="inp" value="Bengaluru" autocomplete="off" placeholder="Start typing…" />
      </div>
      <div class="acwrap">
        <label class="lbl" for="localityInput"><i data-lucide="map" class="w-3.5 h-3.5"></i>Localities <span class="normal-case font-normal text-zinc-400">(add any)</span></label>
        <input id="localityInput" class="inp" autocomplete="off" placeholder="Type an area, e.g. Koramangala" />
        <div id="localities" class="flex flex-wrap gap-1.5 mt-2"></div>
      </div>
      <div>
        <label class="lbl"><i data-lucide="bed-double" class="w-3.5 h-3.5"></i>Configuration (BHK)</label>
        <div id="bhk" class="flex flex-wrap gap-2"></div>
      </div>
      <div>
        <label class="lbl" for="max_price"><i data-lucide="wallet" class="w-3.5 h-3.5"></i>Max rent / month</label>
        <div class="relative">
          <span id="curPrefix" class="absolute left-3 top-1/2 -translate-y-1/2 text-sm text-zinc-500 pointer-events-none">₹</span>
          <input id="max_price" type="number" class="inp pl-8" value="35000" />
        </div>
      </div>
      <div>
        <label class="lbl"><i data-lucide="sofa" class="w-3.5 h-3.5"></i>Furnishing</label>
        <div id="furnishing" class="flex flex-wrap gap-2"></div>
      </div>
      <div>
        <label class="lbl"><i data-lucide="check-check" class="w-3.5 h-3.5"></i>Must-have amenities</label>
        <div id="amenities" class="flex flex-wrap gap-2"></div>
      </div>
      <button id="go" type="submit" class="btnp"><i data-lucide="search" class="w-4 h-4"></i>Search listings</button>
{% endblock %}

{% block table_head %}
              <th class="th w-14"></th>
              <th class="th">Listing</th>
              <th class="th text-right cursor-pointer select-none" data-sort="price">Rent <span class="ar text-indigo-500" data-for="price"></span></th>
              <th class="th text-right cursor-pointer select-none" data-sort="beds">BHK <span class="ar text-indigo-500" data-for="beds"></span></th>
              <th class="th">Source</th>
              <th class="th cursor-pointer select-none" data-sort="score">Match <span class="ar text-indigo-500" data-for="score"></span></th>
              <th class="th">Status</th>
              <th class="th">Assessment</th>
              <th class="th"></th>
{% endblock %}

{% block page_scripts %}
<script>
const $ = (id) => document.getElementById(id);
let results = [], currency = "₹", filterMode = "all", sort = { key:"score", dir:-1 }, cityCoord = null;
const esc = (x) => String(x ?? "").replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const money = (n) => (n===null||n===undefined||n==="") ? "—" : currency + Number(n).toLocaleString();
const icons = () => window.lucide && lucide.createIcons();

/* ---- chip groups ---- */
function chipGroup(el, options, {multi=true, selected=[]}={}){
  el.innerHTML = options.map(o=>{
    const val = typeof o==="object"?o.val:o, label = typeof o==="object"?o.label:o;
    return `<button type="button" data-val="${esc(val)}" class="chip ${selected.includes(val)?"chip-on":""}">${esc(label)}</button>`;
  }).join("");
  el.addEventListener("click", e=>{
    const b=e.target.closest("button"); if(!b)return;
    if(!multi) el.querySelectorAll("button").forEach(x=>x.classList.remove("chip-on"));
    b.classList.toggle("chip-on");
  });
  return () => [...el.querySelectorAll("button.chip-on")].map(b=>b.dataset.val);
}
const getBHK = chipGroup($("bhk"), [{val:"1",label:"1 BHK"},{val:"2",label:"2 BHK"},{val:"3",label:"3 BHK"},{val:"4",label:"4+ BHK"}], {selected:["2"]});
const getFurnishing = chipGroup($("furnishing"), ["Unfurnished","Semi-furnished","Fully furnished"], {multi:false, selected:["Semi-furnished"]});
const getAmenities = chipGroup($("amenities"), ["Car parking","Power backup","Gated community","Lift","Gym","Swimming pool","Pet friendly","24x7 security","Balcony"], {selected:["Car parking","Power backup"]});

/* ---- localities ---- */
const localityList = [];
function renderLocalities(){
  $("localities").innerHTML = localityList.map((n,i)=>
    `<span class="inline-flex items-center gap-1 rounded-full bg-indigo-50 dark:bg-indigo-500/15 text-indigo-700 dark:text-indigo-300 text-xs font-medium pl-2.5 pr-1 py-1">
       ${esc(n)}<button type="button" data-i="${i}" class="rmloc inline-flex"><i data-lucide="x" class="w-3.5 h-3.5"></i></button></span>`).join("");
  icons();
}
$("localities").addEventListener("click", e=>{ const b=e.target.closest(".rmloc"); if(!b)return; localityList.splice(+b.dataset.i,1); renderLocalities(); });
function addLocality(name){ name=name.trim(); if(name && !localityList.includes(name)){ localityList.push(name); renderLocalities(); } }

/* ---- status + terminal ---- */
function setStatus(kind, txt){
  const map = { busy:"bg-indigo-500 pulse", ok:"bg-emerald-500", err:"bg-rose-500", "":"bg-zinc-400" };
  $("led").className = "w-2 h-2 rounded-full " + (map[kind]||map[""]);
  $("statusTxt").textContent = txt;
  $("prog").className = "prog" + (kind==="busy" ? " on" : "");
  $("termState").textContent = kind==="busy"?"running":kind==="err"?"error":kind==="ok"?"done":"idle";
  $("termState").className = "ml-auto text-[11px] font-mono " + (kind==="busy"?"text-indigo-400":kind==="err"?"text-rose-400":kind==="ok"?"text-emerald-400":"text-zinc-500");
}
const TCOL = { info:"text-sky-400", ok:"text-emerald-400", warn:"text-amber-400", error:"text-rose-400" };
const TSYM = { info:"›", ok:"✓", warn:"!", error:"✕" };
function term(level, msg){
  const box=$("term"); if(box.dataset.fresh!=="1"){ box.innerHTML=""; box.dataset.fresh="1"; }
  const t=new Date().toLocaleTimeString(), el=document.createElement("div"); el.className="flex gap-2";
  el.innerHTML=`<span class="text-zinc-600 shrink-0">${t}</span><span class="${TCOL[level]||"text-zinc-400"} shrink-0">${TSYM[level]||"·"}</span><span class="text-zinc-300 break-words">${esc(msg)}</span>`;
  box.appendChild(el); box.scrollTop=box.scrollHeight;
}

/* ---- platforms ---- */
function renderPlatforms(items){
  const box=$("platforms");
  box.innerHTML = (items&&items.length) ? items.map(p=>
    `<span class="inline-flex items-center gap-1.5 rounded-full border border-zinc-200 dark:border-zinc-700 pl-3 pr-1.5 py-1 text-sm">${esc(p.name)}<span class="inline-flex items-center justify-center min-w-5 h-5 px-1 rounded-full bg-indigo-600 text-white text-[11px] font-semibold tabnum">${p.count}</span></span>`
  ).join("") : '<span class="text-sm text-zinc-400">None yet.</span>';
}

/* ---- results ---- */
const median = (a)=>{const s=a.filter(n=>typeof n==="number").sort((x,y)=>x-y); if(!s.length)return null; const m=s.length>>1; return s.length%2?s[m]:Math.round((s[m-1]+s[m])/2);};
const scoreColor = (s)=> s>=75?"bg-emerald-500":s>=50?"bg-amber-500":"bg-zinc-400";
function view(){
  let v = filterMode==="match" ? results.filter(r=>r.match) : results.slice();
  const k=sort.key;
  v.sort((a,b)=>{const av=k==="score"?a.score:(a.listing[k]??-Infinity),bv=k==="score"?b.score:(b.listing[k]??-Infinity);return (av<bv?-1:av>bv?1:0)*sort.dir;});
  return v;
}
function render(){
  const v=view(), tb=$("rows");
  if(!results.length) tb.innerHTML=`<tr><td colspan="9" class="td text-center text-zinc-400 py-12">No results yet.</td></tr>`;
  else if(!v.length) tb.innerHTML=`<tr><td colspan="9" class="td text-center text-zinc-400 py-12">Nothing matches this filter.</td></tr>`;
  else tb.innerHTML = v.map((r,i)=>{
    const l=r.listing, hasUrl=l.url&&l.url!=="#";
    const beds=(l.beds==null)?"—":Number(l.beds);
    const title = hasUrl ? `<a href="${esc(l.url)}" target="_blank" rel="noopener" class="font-medium text-indigo-600 dark:text-indigo-400 hover:underline">${esc(l.title||"Untitled")}</a>` : `<span class="font-medium">${esc(l.title||"Untitled")}</span>`;
    const thumb = `<div class="w-14 h-11 rounded-md bg-zinc-100 dark:bg-zinc-800 overflow-hidden flex items-center justify-center shrink-0 relative"><i data-lucide="image" class="w-4 h-4 text-zinc-400"></i>${l.image?`<img src="${esc(l.image)}" class="absolute inset-0 w-full h-full object-cover" loading="lazy" referrerpolicy="no-referrer" onerror="this.remove()">`:""}</div>`;
    const open = hasUrl ? `<a href="${esc(l.url)}" target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-indigo-600 dark:text-indigo-400 hover:underline text-sm whitespace-nowrap">Open<i data-lucide="external-link" class="w-3.5 h-3.5"></i></a>` : "";
    return `<tr class="${r.status==="match"?"tr-match":""} ${r.status==="filtered"?"opacity-55":""} hover:bg-zinc-50 dark:hover:bg-zinc-800/40">
      <td class="td">${thumb}</td>
      <td class="td max-w-[300px]">${title}<span class="block text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">${esc(l.location||"")}</span></td>
      <td class="td text-right tabnum font-medium whitespace-nowrap">${money(l.price)}</td>
      <td class="td text-right tabnum whitespace-nowrap">${beds}</td>
      <td class="td text-zinc-500 dark:text-zinc-400 whitespace-nowrap">${esc(l.source||"")}</td>
      <td class="td"><div class="flex items-center gap-2"><span class="fitbar"><i class="block h-full ${scoreColor(r.score)}" style="width:${Math.max(0,Math.min(100,r.score))}%"></i></span><span class="tabnum text-xs font-semibold w-6 text-right">${r.score}</span></div></td>
      <td class="td"><span class="badge b-${r.status}">${r.status}</span></td>
      <td class="td text-zinc-500 dark:text-zinc-400 text-[13px] max-w-[260px]">${esc(r.blurb||r.reason||"")}</td>
      <td class="td">${open}</td>
    </tr>`;
  }).join("");
  const prices=results.map(r=>r.listing.price).filter(p=>typeof p==="number");
  $("s0").textContent=results.length||"—";
  $("s1").textContent=results.filter(r=>r.match).length;
  $("s2").textContent=prices.length?money(median(prices)):"—";
  $("s3").textContent=new Set(results.map(r=>r.listing.source).filter(Boolean)).size||"—";
  $("count").textContent=results.length?`Showing ${v.length} of ${results.length}`:"";
  const has=results.length>0; $("expCsv").disabled=!has; $("expJson").disabled=!has;
  document.querySelectorAll(".ar").forEach(a=>a.textContent="");
  const ar=document.querySelector(`.ar[data-for="${sort.key}"]`); if(ar) ar.textContent=sort.dir===-1?"▼":"▲";
  icons();
}
document.querySelectorAll("th[data-sort]").forEach(th=>th.addEventListener("click",()=>{ const k=th.dataset.sort; sort=sort.key===k?{key:k,dir:-sort.dir}:{key:k,dir:-1}; render(); }));
document.querySelectorAll("#filter button").forEach(b=>b.addEventListener("click",()=>{
  document.querySelectorAll("#filter button").forEach(x=>x.className="px-3.5 py-1.5 font-medium text-zinc-500 dark:text-zinc-400"+(x.previousElementSibling?" border-l border-zinc-300 dark:border-zinc-700":""));
  b.className="px-3.5 py-1.5 font-medium bg-indigo-50 dark:bg-indigo-500/15 text-indigo-700 dark:text-indigo-300"+(b.previousElementSibling?" border-l border-zinc-300 dark:border-zinc-700":"");
  filterMode=b.dataset.f; render();
}));

/* ---- autocomplete (Photon / OpenStreetMap) ---- */
const debounce=(fn,ms)=>{let t;return(...a)=>{clearTimeout(t);t=setTimeout(()=>fn(...a),ms)}};
async function photon(q,extra=""){ try{const r=await fetch(`https://photon.komoot.io/api/?q=${encodeURIComponent(q)}&lang=en&limit=6${extra}`); if(!r.ok)return[]; return (await r.json()).features||[];}catch{return[];} }
const fmtPlace=(p)=>[p.name,p.state&&p.state!==p.name?p.state:null,p.country].filter(Boolean).join(", ");
function setCountry(name){ const sel=$("country"),opt=[...sel.options].find(o=>o.value===name); if(opt){sel.value=name; if(opt.dataset.cur){$("curPrefix").textContent=opt.dataset.cur; currency=opt.dataset.cur;}} }
function attachAC(input,getExtra,onPick,filter){
  const box=document.createElement("div"); box.className="ac hidden"; input.parentNode.appendChild(box);
  let items=[]; const close=()=>{box.classList.add("hidden");items=[];};
  const run=debounce(async()=>{ const q=input.value.trim(); if(q.length<2){close();return;}
    let f=await photon(q,getExtra()); if(filter) f=f.filter(x=>filter(x.properties)); items=f.slice(0,6);
    if(!items.length){close();return;}
    box.innerHTML=items.map((x,i)=>`<div class="ac-item" data-i="${i}"><span>${esc(fmtPlace(x.properties))}</span><span class="ac-type">${esc(x.properties.osm_value||"")}</span></div>`).join("");
    box.classList.remove("hidden"); },250);
  input.addEventListener("input",run);
  input.addEventListener("blur",()=>setTimeout(close,150));
  box.addEventListener("mousedown",e=>{const el=e.target.closest(".ac-item");if(!el)return;onPick(items[+el.dataset.i]);close();});
}
attachAC($("city"),()=>"",(f)=>{const p=f.properties;$("city").value=p.name;if(f.geometry){const[lon,lat]=f.geometry.coordinates;cityCoord={lat,lon};}if(p.country)setCountry(p.country);},
  (p)=>p.osm_key==="place"&&["city","town","village","municipality","hamlet","state","county"].includes(p.osm_value));
attachAC($("localityInput"),()=>cityCoord?`&lat=${cityCoord.lat}&lon=${cityCoord.lon}`:"",(f)=>{ addLocality(f.properties.name); $("localityInput").value=""; });
$("localityInput").addEventListener("keydown",e=>{ if(e.key==="Enter"){ e.preventDefault(); addLocality($("localityInput").value); $("localityInput").value=""; }});
$("country").addEventListener("change",e=>{const c=e.target.selectedOptions[0].dataset.cur; if(c){$("curPrefix").textContent=c; currency=c;}});

/* ---- run ---- */
$("form").addEventListener("submit",(e)=>{
  e.preventDefault();
  results=[]; currency=$("curPrefix").textContent||"";
  $("term").dataset.fresh="0"; $("term").innerHTML=""; renderPlatforms([]);
  $("rows").innerHTML=`<tr><td colspan="9" class="td text-center text-zinc-400 py-12">Searching…</td></tr>`;
  ["s0","s1","s2","s3"].forEach(id=>$(id).textContent="—");
  $("go").disabled=true; setStatus("busy","Searching");

  const bhk=getBHK(); const minBeds = bhk.length ? Math.min(...bhk.map(Number)) : "";
  const keywords = [...getFurnishing(), ...getAmenities()].join(", ");
  const qs=new URLSearchParams({
    country:$("country").value, city:$("city").value, area:localityList.join(" or "),
    currency, max_price:$("max_price").value, min_beds:minBeds, keywords, threshold:60,
  });
  const es=new EventSource("/api/hunt?"+qs.toString());
  es.addEventListener("log",ev=>{const d=JSON.parse(ev.data);term(d.level,d.msg);});
  es.addEventListener("sources",ev=>renderPlatforms(JSON.parse(ev.data).items));
  es.addEventListener("listing",ev=>{results.push(JSON.parse(ev.data));render();});
  es.addEventListener("done",ev=>{const d=JSON.parse(ev.data);render();
    if(!results.length) setStatus("err","No listings found"); else setStatus("ok",`${d.matched} match${d.matched===1?"":"es"} of ${d.processed}`);
    $("go").disabled=false; es.close();});
  es.onerror=()=>{term("error","Connection closed");setStatus("err","Interrupted");$("go").disabled=false;es.close();};
});

/* ---- export ---- */
function download(name,text,type){const b=new Blob([text],{type}),u=URL.createObjectURL(b),a=document.createElement("a");a.href=u;a.download=name;document.body.appendChild(a);a.click();a.remove();URL.revokeObjectURL(u);}
$("expJson").addEventListener("click",()=>{const rows=view().map(r=>({...r.listing,match_score:r.score,match:r.match,status:r.status,assessment:r.blurb||r.reason}));if(rows.length)download("apartments.json",JSON.stringify(rows,null,2),"application/json");});
$("expCsv").addEventListener("click",()=>{const rows=view();if(!rows.length)return;
  const cols=["title","price","beds","location","source","match_score","match","status","assessment","url","image"],cell=v=>`"${String(v??"").replace(/"/g,'""')}"`,lines=[cols.join(",")];
  for(const r of rows){const l=r.listing;lines.push([l.title,l.price,l.beds,l.location,l.source,r.score,r.match,r.status,(r.blurb||r.reason),l.url,l.image].map(cell).join(","));}
  download("apartments.csv",lines.join("\r\n"),"text/csv;charset=utf-8");});

renderLocalities(); icons();
</script>
{% endblock %}
