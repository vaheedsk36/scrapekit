# Copy to .env and add your own key. Bring-your-own-key: nothing is shared.

# REQUIRED for the web app (powers both web search and listing scoring):
OPENAI_API_KEY=sk-...

# OPTIONAL — only for the CLI cron/alert path (Telegram notifications):
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWxyz
TELEGRAM_CHAT_ID=123456789
