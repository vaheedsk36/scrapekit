# Copy to .env and add your own key. Bring-your-own-key: nothing is shared.
#
# You can also set the provider + key + model live from the app's Settings panel
# (OpenAI / Anthropic / xAI Grok) — that key is cached on the server, not here.
# This OPENAI_API_KEY is the optional default used when Settings is untouched:
OPENAI_API_KEY=sk-...

# OPTIONAL — only for the CLI cron/alert path (Telegram notifications):
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWxyz
TELEGRAM_CHAT_ID=123456789
